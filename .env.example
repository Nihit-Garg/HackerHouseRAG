# Required
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional overrides (all have sensible defaults — only set what you want to change)
# MSMARCO_SUBSET_SIZE=5000
# LANGUAGE_FILTER=en
# CHUNKING_STRATEGY=metadata
# CHUNK_SIZE_TOKENS=256
# CHUNK_OVERLAP_PCT=0.2
# TOP_K=5

# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_BATCH_SIZE=64

# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT_S=120

# SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# SARVAM_LANGUAGE_CODE=en-IN
# SARVAM_MODEL=saarika:v2
# STT_MAX_RETRIES=2
# STT_RETRY_BASE_DELAY_S=1.0

# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=true
